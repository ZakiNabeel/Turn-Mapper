{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turn.local/contract/turnmap/0.1.0",
  "title": "TURN Map Package v0.1 (venue.json and floor.json)",
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 4
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "auto",
            "manual",
            "corrected"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ocr_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "venue": {
      "type": "object",
      "required": [
        "schema_version",
        "generator",
        "venue",
        "buildings",
        "floors",
        "transitions"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^0\\.1\\.\\d+$"
        },
        "generator": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "venue": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "buildings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "floors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "building_id",
              "level",
              "name",
              "validation_passed"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "building_id": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "source": {
                "type": "object"
              },
              "validation_passed": {
                "type": "boolean"
              },
              "floor": {
                "$ref": "#/$defs/floor"
              }
            },
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "floor"
                ]
              }
            ]
          }
        },
        "transitions": {
          "type": "array"
        }
      }
    },
    "floor": {
      "type": "object",
      "required": [
        "floor_id",
        "image",
        "transform",
        "bounds_m",
        "walkable",
        "walls",
        "doors",
        "rooms",
        "graph",
        "pois",
        "validation"
      ],
      "properties": {
        "floor_id": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "required": [
            "file",
            "width_px",
            "height_px"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "width_px": {
              "type": "integer"
            },
            "height_px": {
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            }
          }
        },
        "transform": {
          "type": "object",
          "required": [
            "px_to_m",
            "scale_m_per_px",
            "scale_source"
          ],
          "properties": {
            "px_to_m": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 2,
              "maxItems": 2
            },
            "scale_m_per_px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scale_source": {
              "enum": [
                "operator_two_point",
                "ocr_dimension",
                "cad_units",
                "scale_bar",
                "door_width_prior",
                "footprint_transfer",
                "measured_room_size",
                "door_width_calibrated"
              ]
            },
            "scale_evidence": {
              "type": "array"
            }
          }
        },
        "bounds_m": {
          "type": "object",
          "required": [
            "min_x",
            "min_y",
            "max_x",
            "max_y"
          ],
          "properties": {
            "min_x": {
              "type": "number"
            },
            "min_y": {
              "type": "number"
            },
            "max_x": {
              "type": "number"
            },
            "max_y": {
              "type": "number"
            }
          }
        },
        "walkable": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ring"
                },
                "minItems": 1
              }
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "a",
              "b"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "a": {
                "$ref": "#/$defs/point"
              },
              "b": {
                "$ref": "#/$defs/point"
              },
              "thickness_m": {
                "type": "number"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "doors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "a",
              "b"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "a": {
                "$ref": "#/$defs/point"
              },
              "b": {
                "$ref": "#/$defs/point"
              },
              "room_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "polygon"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "polygon": {
                "$ref": "#/$defs/ring"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "x",
                  "y",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "kind": {
                    "enum": [
                      "corridor",
                      "junction",
                      "door",
                      "transition"
                    ]
                  },
                  "door_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "provenance": {
                    "$ref": "#/$defs/provenance"
                  },
                  "transition": {
                    "enum": [
                      "stairs",
                      "lift",
                      "escalator"
                    ]
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "from",
                  "to",
                  "length_m",
                  "type",
                  "bidirectional"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "length_m": {
                    "type": "number",
                    "minimum": 0
                  },
                  "type": {
                    "enum": [
                      "corridor",
                      "door",
                      "stairs",
                      "lift",
                      "escalator"
                    ]
                  },
                  "bidirectional": {
                    "type": "boolean"
                  },
                  "accessible": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "provenance": {
                    "$ref": "#/$defs/provenance"
                  }
                }
              }
            }
          }
        },
        "pois": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "node_id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "node_id": {
                "type": "string"
              },
              "room_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "needs_review": {
                "type": "boolean"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "required": [
            "passed",
            "forced",
            "errors",
            "warnings"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "forced": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              }
            }
          }
        }
      }
    }
  }
}
